# erxes — server-side (not exposed to browser)
ERXES_APP_TOKEN=your_erxes_app_token
ERXES_ADMIN_TOKEN=your_erxes_admin_token
ERXES_ENVIRONMENT=staging
ERXES_CLIENT_PORTAL_ID=your_client_portal_id
GRAPHQL_URL=https://your-tenant.next.erxes.io/gateway/graphql

# Public media origin only; never put an erxes token or GraphQL endpoint here.
NEXT_PUBLIC_ERXES_ASSET_ORIGIN=https://your-tenant.next.erxes.io
